  m_Script: {fileID: 11500000, guid: 94872708bfe9e4851981e9e1837f1ac3, type: 3}
  m_Name: StereoscopicCamera
  m_EditorClassIdentifier: 
  exhibitName: Stereoscopic Camera
  description: "This stereoscopic camera, produced by the Ernemann-Werke company
    in Dresden, represents an important stage in the evolution of early photographic
    technology. Featuring two precisely aligned lenses, the instrument was designed
    to capture simultaneous images from slightly different angles, mirroring human
    binocular vision. When viewed through a stereoscope, these paired photographs
    created a striking three-dimensional effect, offering audiences one of the earliest
    forms of immersive visual experience.  \nConstructed with durable metal fittings
    and a compact folding housing, this camera showcases the engineering sophistication
    of pre-war German optical manufacturing."
  audio: {fileID: 8300000, guid: 626963a16c04c834dafb01129b84240a, type: 3}
